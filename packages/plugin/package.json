{
	"name": "@leon8ix/skeleton-v2-tailwind",
	"version": "0.4.1",
	"description": "Core plugin for Skeleton.",
	"scripts": {
		"build": "tsx ./scripts/generate-jss.ts && esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --packages=external --outfile=dist/index.js && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run",
		"format": "prettier --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/leon8ix/skeleton-v2.git",
		"directory": "packages/plugin"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"bugs": {
		"url": "https://github.com/leon8ix/skeleton-v2/issues"
	},
	"keywords": [
		"cli",
		"components",
		"ui",
		"component",
		"svelte",
		"component-library",
		"ui-components",
		"ui-framework",
		"tailwind",
		"tailwindcss",
		"components-library",
		"sveltekit"
	],
	"license": "MIT",
	"homepage": "https://skeleton.dev/",
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/postcss-js": "^4.1.0",
		"esbuild": "^0.28.2",
		"postcss": "^8.5.31",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"postcss": "^8.5.29",
		"tailwindcss": "^4.3.3"
	},
	"type": "commonjs",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"./dist/**/*.js",
		"./dist/**/*.d.ts",
		"./dist/**/*.cjs",
		"./dist/**/*.d.cts",
		"!./dist/**/*.test.*",
		"./src/styles/*.css",
		"LICENSE",
		"LICENSE-TAILWIND"
	],
	"dependencies": {
		"postcss-js": "^5.1.0",
		"postcss-selector-parser": "^7.1.7"
	}
}
