{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"]
		},
		"types": ["svelte", "vite/client", "vitest/globals"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
