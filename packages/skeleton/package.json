{
	"name": "@leon8ix/skeleton-v2",
	"version": "2.11.0",
	"description": "A SvelteKit component library.",
	"author": "endigo9740 <chris@skeletonlabs.dev>",
	"scripts": {
		"build": "svelte-package",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"format": "prettier --write ."
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/leon8ix/skeleton-v2.git"
	},
	"bugs": {
		"url": "https://github.com/leon8ix/skeleton-v2/issues"
	},
	"keywords": [
		"cli",
		"components",
		"ui",
		"component",
		"svelte",
		"component-library",
		"ui-components",
		"ui-framework",
		"tailwind",
		"tailwindcss",
		"components-library",
		"sveltekit"
	],
	"license": "MIT",
	"homepage": "https://skeleton.dev/",
	"devDependencies": {
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/svelte": "^5.4.2",
		"jsdom": "^30.1.3",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"esm-env": "^1.2.2"
	},
	"peerDependencies": {
		"svelte": "^5.57.2"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./*": "./dist/*"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*Test.svelte",
		"!dist/**/*Test.svelte.d.ts"
	],
	"svelte": "./dist/index.js"
}
