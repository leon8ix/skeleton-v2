{
	"name": "skeleton-v2",
	"version": "1.0.0",
	"description": "Maintained Skeleton v2 UI library and styling plugin",
	"private": true,
	"scripts": {
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run check --workspaces",
		"test": "npm run test --workspaces",
		"build": "npm run build --workspaces",
		"pack": "npm run build && npm pack --workspaces"
	},
	"license": "MIT",
	"homepage": "https://skeleton.dev/",
	"repository": {
		"type": "git",
		"url": "https://github.com/leon8ix/skeleton-v2.git"
	},
	"bugs": {
		"url": "https://github.com/leon8ix/skeleton-v2/issues"
	},
	"keywords": [
		"cli",
		"components",
		"ui",
		"component",
		"svelte",
		"component-library",
		"ui-components",
		"ui-framework",
		"tailwind",
		"tailwindcss",
		"components-library",
		"sveltekit"
	],
	"devDependencies": {
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"@types/jsdom": "^30.0.0",
		"typescript": "^6.0.3",
		"@types/node": "^24.19.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "npm@12.0.2",
	"type": "module",
	"workspaces": [
		"packages/skeleton",
		"packages/plugin"
	]
}
